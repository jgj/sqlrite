    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.45.1",
    "glob": "^11.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "@libsql/client": "^0.15.2",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.45.0"
  },
  "peerDependenciesMeta": {
